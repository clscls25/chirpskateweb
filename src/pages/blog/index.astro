---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog — Chirp Skate" description="Tips, updates, and stories from the Chirp Skate team.">
  <div class="page">
    <header class="page-header">
      <h1>Blog</h1>
      <p>Tips, updates, and stories from the Chirp Skate team.</p>
    </header>

    {posts.length === 0 ? (
      <p class="empty">No posts yet — check back soon.</p>
    ) : (
      <ul class="post-list">
        {posts.map(post => (
          <li>
            <a href={`/blog/${post.slug}`} class="post-card">
              <div class="post-meta">
                <time datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                </time>
              </div>
              <h2>{post.data.title}</h2>
              <p class="post-desc">{post.data.description}</p>
              <span class="read-more">Read more →</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</BaseLayout>

<style>
  .page {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 56px 24px;
  }

  .page-header {
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--border);
  }

  .page-header h1 {
    font-size: 36px;
    font-weight: 800;
    color: var(--text);
    margin-bottom: 8px;
    letter-spacing: -0.5px;
  }

  .page-header p {
    font-size: 16px;
    color: var(--text-muted);
  }

  .post-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .post-card {
    display: block;
    padding: 32px 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    color: inherit;
  }

  .post-card:hover { text-decoration: none; }
  .post-card:hover h2 { color: var(--primary); }

  .post-meta time {
    font-size: 13px;
    color: var(--text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .post-card h2 {
    font-size: 22px;
    font-weight: 700;
    color: var(--text);
    margin: 8px 0 10px;
    line-height: 1.3;
    transition: color 0.15s;
  }

  .post-desc {
    font-size: 15px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 14px;
  }

  .read-more {
    font-size: 14px;
    font-weight: 500;
    color: var(--primary);
  }

  .empty {
    color: var(--text-muted);
    font-size: 16px;
  }
</style>
