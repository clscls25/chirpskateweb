---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const features = [
  {
    icon: '📈',
    title: 'Track prices over time',
    desc: 'Log what you pay and see exactly when prices go up or down. No more wondering if you got a good deal.',
  },
  {
    icon: '🧾',
    title: 'Scan receipts instantly',
    desc: 'Point your camera at any receipt and let AI pull out every item, price, and quantity automatically.',
  },
  {
    icon: '⚖️',
    title: 'Compare unit costs',
    desc: 'See price-per-oz, per-lb, or per-unit side by side so the real bargain is always obvious.',
  },
  {
    icon: '🏠',
    title: 'Share with your household',
    desc: 'Invite family members to a shared household. Everyone sees the same purchase history.',
  },
];
---

<BaseLayout title="Chirp Skate — Track What You Spend">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <img src="/logo.png" alt="Chirp Skate" class="hero-logo" width="88" height="88" onerror="this.style.display='none'" />
      <h1>Know what you <em>actually</em> pay</h1>
      <p class="hero-sub">
        Chirp Skate tracks your purchase prices over time, compares unit costs,
        and helps your household shop smarter — every trip, every store.
      </p>
      <div class="store-buttons">
        <a href="https://apps.apple.com/app/chirp-skate/id6741440906" class="store-btn apple" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/></svg>
          App Store
        </a>
        <a href="https://play.google.com/store/apps/details?id=com.chirpskate.chirp_skate" class="store-btn google" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M3.18 23.76c.35.2.74.24 1.1.12l12.44-7.18-2.57-2.57-11 11zM20.7 10.34l-2.86-1.65-2.9 2.9 2.9 2.9 2.89-1.67c.82-.48.82-1.62-.03-2.48zM2.06.6A1.44 1.44 0 0 0 1.75 1.5v21c0 .34.1.65.3.9l.05.05L13.53 12 2.1.54zM4.28.12L16.72 7.3l-2.57 2.57L4.28.12z"/></svg>
          Google Play
        </a>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="features">
    <div class="features-inner">
      {features.map(f => (
        <div class="feature-card">
          <span class="feature-icon">{f.icon}</span>
          <h3>{f.title}</h3>
          <p>{f.desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Blog preview -->
  {posts.length > 0 && (
    <section class="blog-preview">
      <div class="blog-preview-inner">
        <h2>From the blog</h2>
        <ul class="post-list">
          {posts.map(post => (
            <li>
              <a href={`/blog/${post.slug}`} class="post-item">
                <span class="post-title">{post.data.title}</span>
                <time class="post-date" datetime={post.data.date.toISOString()}>
                  {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
              </a>
            </li>
          ))}
        </ul>
        <a href="/blog" class="blog-link">All posts →</a>
      </div>
    </section>
  )}
</BaseLayout>

<style>
  /* Hero */
  .hero {
    background: linear-gradient(160deg, #f0f9ff 0%, #ffffff 60%);
    border-bottom: 1px solid var(--border);
    padding: 72px 24px 64px;
    text-align: center;
  }

  .hero-inner {
    max-width: var(--max-w);
    margin: 0 auto;
  }

  .hero-logo {
    border-radius: 20px;
    margin: 0 auto 28px;
    box-shadow: 0 4px 20px rgba(66, 164, 209, 0.2);
  }

  .hero h1 {
    font-size: clamp(28px, 5vw, 44px);
    font-weight: 800;
    line-height: 1.15;
    color: var(--text);
    margin-bottom: 16px;
    letter-spacing: -0.5px;
  }

  .hero h1 em {
    font-style: normal;
    color: var(--primary);
  }

  .hero-sub {
    font-size: 18px;
    color: var(--text-muted);
    max-width: 500px;
    margin: 0 auto 36px;
    line-height: 1.6;
  }

  .store-buttons {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .store-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .store-btn:hover { opacity: 0.85; text-decoration: none; }

  .store-btn.apple {
    background: #111;
    color: #fff;
  }

  .store-btn.google {
    background: #111;
    color: #fff;
  }

  /* Features */
  .features {
    padding: 72px 24px;
  }

  .features-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }

  .feature-card {
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: #fff;
  }

  .feature-icon {
    font-size: 28px;
    display: block;
    margin-bottom: 14px;
  }

  .feature-card h3 {
    font-size: 16px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 8px;
  }

  .feature-card p {
    font-size: 14px;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* Blog preview */
  .blog-preview {
    background: #f9fafb;
    border-top: 1px solid var(--border);
    padding: 56px 24px;
  }

  .blog-preview-inner {
    max-width: var(--max-w);
    margin: 0 auto;
  }

  .blog-preview h2 {
    font-size: 20px;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 24px;
  }

  .post-list {
    list-style: none;
    margin: 0 0 20px;
  }

  .post-list li {
    border-bottom: 1px solid var(--border);
  }

  .post-list li:last-child { border-bottom: none; }

  .post-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 14px 0;
    color: var(--text);
    text-decoration: none;
  }

  .post-item:hover .post-title { color: var(--primary); }
  .post-item:hover { text-decoration: none; }

  .post-title {
    font-size: 15px;
    font-weight: 500;
  }

  .post-date {
    font-size: 13px;
    color: var(--text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .blog-link {
    font-size: 14px;
    font-weight: 500;
    color: var(--primary);
  }
</style>
