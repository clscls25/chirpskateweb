---
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Track purchase prices over time, compare unit costs, and find the best deals.',
  ogImage = '/logo.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />

  <meta name="theme-color" content="#42A4D1" />
  <link rel="icon" href="/logo.png" type="image/png" />
</head>
<body>
  <header>
    <nav>
      <a href="/" class="brand">
        <img src="/logo.png" alt="" width="28" height="28" onerror="this.style.display='none'" />
        <span>Chirp Skate</span>
      </a>
      <a href="/blog" class="nav-link">Blog</a>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer>
    <div class="footer-inner">
      <span>© 2026 Chirp Skate</span>
      <div class="footer-links">
        <a href="/privacy">Privacy</a>
        <a href="/blog">Blog</a>
      </div>
    </div>
  </footer>
</body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --primary: #42A4D1;
    --primary-dark: #2d8bc9;
    --text: #111827;
    --text-muted: #6b7280;
    --border: #e5e7eb;
    --bg: #ffffff;
    --max-w: 760px;
    --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--font);
    background: var(--bg);
    color: var(--text);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
  }

  a { color: var(--primary); text-decoration: none; }
  a:hover { text-decoration: underline; }

  img { display: block; max-width: 100%; }

  /* ---- Nav ---- */
  header {
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(8px);
    z-index: 10;
  }

  nav {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 24px;
    height: 58px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 16px;
    color: var(--text);
    text-decoration: none;
  }

  .brand img {
    border-radius: 7px;
  }

  .brand:hover { text-decoration: none; color: var(--primary); }

  .nav-link {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .nav-link:hover { color: var(--primary); text-decoration: none; }

  /* ---- Footer ---- */
  footer {
    border-top: 1px solid var(--border);
    padding: 28px 24px;
    margin-top: 80px;
  }

  .footer-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13px;
    color: var(--text-muted);
  }

  .footer-links {
    display: flex;
    gap: 20px;
  }

  .footer-links a {
    color: var(--text-muted);
    font-size: 13px;
  }

  .footer-links a:hover { color: var(--primary); }

  /* ---- Prose (blog posts) ---- */
  .prose {
    font-size: 17px;
    line-height: 1.75;
    color: #374151;
  }

  .prose h2 {
    font-size: 22px;
    font-weight: 700;
    color: var(--text);
    margin: 2em 0 0.6em;
    line-height: 1.3;
  }

  .prose h3 {
    font-size: 18px;
    font-weight: 600;
    color: var(--text);
    margin: 1.6em 0 0.5em;
  }

  .prose p { margin-bottom: 1.25em; }

  .prose ul, .prose ol {
    margin: 0 0 1.25em 1.5em;
  }

  .prose li { margin-bottom: 0.4em; }

  .prose strong { color: var(--text); font-weight: 600; }

  .prose a { color: var(--primary); }

  .prose code {
    font-family: 'SF Mono', Consolas, monospace;
    font-size: 0.875em;
    background: #f3f4f6;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .prose blockquote {
    border-left: 3px solid var(--primary);
    padding-left: 1em;
    margin: 1.5em 0;
    color: var(--text-muted);
    font-style: italic;
  }

  .prose img {
    max-width: 100%;
    height: auto;
    border-radius: 10px;
    margin: 0.5em 0 1.25em;
  }

  .prose hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5em 0;
  }
</style>
